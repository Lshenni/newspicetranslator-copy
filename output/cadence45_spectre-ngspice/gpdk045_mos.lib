* Subcircuit: gpdk045_mosvar1v
.subckt gpdk045_mosvar1v n1 n2
.param xl=0
.param xw=0
.param area={(ll*factor-xl+dxl_v)*(ww*factor-xw+dxw_v)}
.param pl={2*(ll*factor-xl+dxl_v)}
.param pw={2*(ww*factor-xw+dxw_v)}
.param cgmin={(1.85e-3*area+1.02e-10*pl+8.1e-11*pw)*cgmin_v}
.param dcg={(5.87e-3*area+3.7e-12*pl-1.85e-11*pw)*dcg_v}
.param dvg={-0.076-6.5E-05*(temp-25)}
.param vgnorm={0.33+3.4E-04*(temp-25)}
X1 n1 n2 bsource q={multi*((cgmin+dcg)*v(n1,n2)+vgnorm*dcg*log(cosh((v(n1,n2)-dvg)/vgnorm))/log(2.71828))}
.ends gpdk045_mosvar1v

* Subcircuit: gpdk045_mosvar2v
.subckt gpdk045_mosvar2v n1 n2
.param xl=0
.param xw=0
.param area={(ll*factor-xl+dxl_v18)*(ww*factor-xw+dxw_v18)}
.param pl={2*(ll*factor-xl+dxl_v18)}
.param pw={2*(ww*factor-xw+dxw_v18)}
.param cgmin={(1.03e-3*area+9.46e-11*pl+1.12e-10*pw)*cgmin_v18}
.param dcg={(3.988e-3*area+1.97e-11*pl-4.8e-11*pw)*dcg_v18}
.param dvg={-0.158-4.1E-05*(temp-25)}
.param vgnorm={0.45+5.1E-04*(temp-25)}
X1 n1 n2 bsource q={multi*((cgmin+dcg)*v(n1,n2)+vgnorm*dcg*log(cosh((v(n1,n2)-dvg)/vgnorm))/log(2.71828))}
.ends gpdk045_mosvar2v

* Subcircuit: ressnpoly_rg
.subckt ressnpoly_rg n1 n2
.param dxw_ressnpoly=0
.param pvc1=1.51e-6
.param pvc2=1.13e-12
.param ptc1=3.32e-3
.param ptc2=-1.71e-6
.param rsh=15
.param dw={dxw_ressnpoly}
.param pt={temp}
.param tfac={1.0+ptc1*(pt-25.0)+ptc2*(pt-25.0)*(pt-25.0)}
X1 n1 n2 bsource r={rsh/mf*ll/(ww-dw)*(1+pvc1*(abs(v(n2,n1))/ll)+pvc2*(v(n2,n1)/ll)*(v(n2,n1)/ll))*tfac}
.ends ressnpoly_rg

* Subcircuit: ressppoly_rg
.subckt ressppoly_rg n1 n2
.param dxw_ressppoly=0
