.param rsh=15
.param dw={dxw_ressppoly}
.param pt={temp}
.param tfac={1.0+ptc1*(pt-25.0)+ptc2*(pt-25.0)*(pt-25.0)}
X1 n1 n2 bsource r={rsh/mf*ll/(ww-dw)*(1+pvc1*(abs(v(n2,n1))/ll)+pvc2*(v(n2,n1)/ll)*(v(n2,n1)/ll))*tfac}
.ends ressppoly_rg

