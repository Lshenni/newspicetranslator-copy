* Subcircuit: g45n1lvt
.subckt g45n1lvt d g s b
.param l=1e-6
.param w=1e-6
.param multi=1
.param nf=1
.param factor=1
.param dmcg=4E-8
.param xw={0+dxw_n_lvt}
.param ad={2*dmcg/factor*(w/nf+xw/factor)}
.param as={2*dmcg/factor*(w/nf+xw/factor)}
.param pd={4*dmcg/factor+2*(w/nf+xw/factor)}
.param ps={4*dmcg/factor+2*(w/nf+xw/factor)}
.param nrd={dmcg/factor/(w/nf+xw/factor)}
.param nrs={dmcg/factor/(w/nf+xw/factor)}
.param sa={6.1E-7/factor}
.param sb={6.1E-7/factor}
.param sd={2*dmcg/factor}
.param sca={1E-6/factor}
.param scb={1E-6/factor}
.param scc={1E-6/factor}
.param misa1={rn1_lvt}
.param misa2={rn2_lvt}
.param fac1={0.335*misa1+0.542*misa2}
.param fac2={0.335*misa1-0.542*misa2}
.param lef={l*factor}
.param wef={w/nf*factor}
.param geo_fac={1/sqrt(m*nf*lef*wef*1e12)}
.param vthmis_n={0.00178*geo_fac*fac1}
.param dlmis_n={0.00121*geo_fac*lef*fac2}
.param dwmis_n={-0.00121*geo_fac*wef*fac2}
.param toxmis_n={0.00121*geo_fac*tox_n_lvt*fac2}
