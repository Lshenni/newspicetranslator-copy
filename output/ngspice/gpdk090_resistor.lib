* Monte Carlo Analysis Instructions
* ====================================
*
* The subcircuit above includes Monte Carlo support via:
*   .param mc_en=0    (Monte Carlo enable: 0=off, 1=on)
*   .func mc_gauss()  (Gaussian random number generator)
*
* To run Monte Carlo analysis:
*   1. Enable: .param mc_en=1
*   2. Run: .control
*           mcruns = 100
*           let mc_run = 0
*           dowhile mc_run < mcruns
*             ac dec 10 1 1e9
*             let mc_run = mc_run + 1
*           end
*           .endc
*
* Corner Analysis Instructions
* ==============================
*
* Process corners via cap_var parameter:
*   Typical: .param cap_var=1.0
*   Low:     .param cap_var=0.9
*   High:    .param cap_var=1.1

.model gpdk090_resm8x resistor (mr=0.71*10m rsh=0.02*crmet*(1+10m*pres_mc) tc1=0.003 trise=triseRes)

* Subcircuit: gpdk090_ressndiff
.subckt gpdk090_ressndiff PLUS MINUS B
  l = 0.6e-6 \
  w = 0.6e-6 \
  simM=1 \
  Pwl=2.0 \
  geo_fac=.01*sqrt(Pwl*Pwl/(l*w*1e12))  \
  delmis= geo_fac * pres_mc / sqrt(simM) \
  w_mc=w/(1+delmis)
  gpdk090_ressndiff  (PLUS MINUS B) ressndiff l=l w=w_mc
  Rnoise (PLUS MINUS) rnoise_va l=l w=w rsh=10
.ends gpdk090_ressndiff

* Subcircuit: gpdk090_resnspdiff
.subckt gpdk090_resnspdiff PLUS MINUS B
